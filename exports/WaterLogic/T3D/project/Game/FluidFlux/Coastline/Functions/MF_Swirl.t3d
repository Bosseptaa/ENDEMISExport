   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Coastline/Functions/MF_Swirl.MF_Swirl:MaterialExpressionCustom_2'"
      Code=" float2 tc = (uv -center)* scale;\r\n  float dist = length(tc);\r\n  if (dist < radius) \r\n  {\r\n    float percent = (radius - dist) / radius;\r\n    float theta = pow(percent,power) * angle;\r\n    float s = sin(theta);\r\n    float c = cos(theta);\r\n    tc = float2(dot(tc, float2(c, -s)), dot(tc, float2(s, c))) + percent * float2(-100.0,-100.0);\r\n  }\r\n return tc/scale + center;"
      OutputType=CMOT_Float2
      Description="Swirl"
      Inputs(0)=(InputName="uv",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Swirl:MaterialExpressionFunctionInput_1'"))
      Inputs(1)=(InputName="center",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Swirl:MaterialExpressionFunctionInput_0'"))
      Inputs(2)=(InputName="radius",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Swirl:MaterialExpressionFunctionInput_2'"))
      Inputs(3)=(InputName="angle",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Swirl:MaterialExpressionFunctionInput_3'"))
      Inputs(4)=(InputName="power",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Swirl:MaterialExpressionFunctionInput_4'"))
      Inputs(5)=(InputName="scale",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Swirl:MaterialExpressionFunctionInput_5'"))
      MaterialExpressionEditorX=-416
      MaterialExpressionEditorY=400
      MaterialExpressionGuid=B4007CA74BF36CC9CB5E01AF5EDA48AE
      Function="/Script/Engine.MaterialFunction'MF_Swirl'"
   End Object
