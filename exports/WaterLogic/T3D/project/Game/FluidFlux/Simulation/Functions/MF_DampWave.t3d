   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Simulation/Functions/MF_DampWave.MF_DampWave:MaterialExpressionCustom_0'"
      Code="if (uC > 0.0)\r\n{\r\n   if (totalSlope < -edge) \r\n   {\r\n     if (uR < 0.0)\r\n         uC  = uC * scale;\r\n     \r\n     if (uL > 0.0)\r\n        uC  = uC * scale2;  \r\n   }\r\n} else\r\n{\r\n   if (totalSlope > edge) \r\n   {\r\n     if (uL > 0.0)\r\n          uC = uC * scale;\r\n\r\n     if (uR < 0.0)\r\n          uC = uC * scale2;\r\n   }\r\n} return uC;"
      OutputType=CMOT_Float1
      Description="Damp"
      Inputs(0)=(InputName="uC",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_DampWave:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="uL",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_DampWave:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="uR",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_DampWave:MaterialExpressionFunctionInput_2'"))
      Inputs(3)=(InputName="totalSlope",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_DampWave:MaterialExpressionFunctionInput_3'"))
      Inputs(4)=(InputName="edge",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_DampWave:MaterialExpressionScalarParameter_0'"))
      Inputs(5)=(InputName="scale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_DampWave:MaterialExpressionScalarParameter_1'"))
      Inputs(6)=(InputName="scale2",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_DampWave:MaterialExpressionScalarParameter_2'"))
      MaterialExpressionEditorX=-80
      MaterialExpressionEditorY=704
      MaterialExpressionGuid=DA6F85684AE88891FBD8999379063FA7
      Function="/Script/Engine.MaterialFunction'MF_DampWave'"
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Simulation/Functions/MF_DampWave.MF_DampWave:MaterialExpressionCustom_3'"
      Code="    if (u < 0.0f && (vL > 0.0f && vR > 0.0f))\r\n      u = 0.0;\r\n    \r\n    if (u > 0.0f && (vL < 0.0f && vR < 0.0f))\r\n      u = 0.0;\r\nreturn u;"
      OutputType=CMOT_Float1
      Description="Damp"
      Inputs(0)=(InputName="u",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_DampWave:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="vL",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_DampWave:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="vR",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_DampWave:MaterialExpressionFunctionInput_2'"))
      MaterialExpressionEditorX=-96
      MaterialExpressionEditorY=496
      MaterialExpressionGuid=DA6F85684AE88891FBD8999379063FA7
      Function="/Script/Engine.MaterialFunction'MF_DampWave'"
   End Object
