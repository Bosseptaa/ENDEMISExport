   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Simulation/Functions/MF_ShallowIntegrateVelocity.MF_ShallowIntegrateVelocity:MaterialExpressionCustom_1'"
      Code="BRANCH\r\nif (x>0.0f)\r\nreturn v;\r\nelse\r\nreturn float2(0.0f,0.0f);"
      OutputType=CMOT_Float2
      Inputs(0)=(InputName="x",Input=(Expression="/Script/Engine.MaterialExpressionMax'MF_ShallowIntegrateVelocity:MaterialExpressionMax_4'"))
      Inputs(1)=(InputName="v",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_ShallowIntegrateVelocity:MaterialExpressionMaterialFunctionCall_11'"))
      MaterialExpressionEditorX=352
      MaterialExpressionEditorY=-528
      MaterialExpressionGuid=BC11CD244E5EA6D5E45C008E895D4265
      Function="/Script/Engine.MaterialFunction'MF_ShallowIntegrateVelocity'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Simulation/Functions/MF_ShallowIntegrateVelocity.MF_ShallowIntegrateVelocity:MaterialExpressionCustom_3'"
      Code="float change = 0.0f;\r\n\r\nBRANCH if (Blend > 0.0)\r\n{\r\n\tif (HC > 0.0)\r\n\t{\r\n\t\tif ((HC - HL > Limit) && (HC > HR))\r\n\t\t{\r\n\t\t\tfloat remove = Blend * (max(0.0, 0.5 * (VC + VR))-VC);\r\n\t//\t\tHR+= remove;\r\n\t//\t\tHC+= remove;\r\n\t\t\tchange += remove;\r\n\t\t}\r\n\r\n\t\tif ((HC - HR > Limit) && (HC > HL))\r\n\t\t{\r\n\t\t\tfloat remove = Blend * (max(0.0, 0.5 * (VC + VL))-VC);\r\n\t//\t\tHR+= remove;\r\n\t//\t\tHC+= remove;\r\n\t\t\t\tchange += remove;\r\n\t\t}\r\n\t\t\r\n\t\tif ((HC - HB > Limit) && (HC > HT))\r\n\t\t{\r\n\t\t\tfloat remove = Blend * (max(0.0, 0.5 * (VC + VT))-VC);\r\n\t//\t\tHR+= remove;\r\n\t//\t\tHC+= remove;\r\n\t\t\tchange += remove;\r\n\t\t}\t\t\r\n\r\n\r\n\t\tif ((HC - HT > Limit) && (HC > HB))\r\n\t\t{\r\n\t\t\tfloat remove = Blend * (max(0.0, 0.5 * (VC + VB))-VC);\r\n\t//\t\tHR+= remove;\r\n\t\t//\tHC+= remove;\r\n\t\t\tchange += remove;\r\n\t\t}\r\n\t}\r\n\t\r\n\treturn change;\r\n}\r\nreturn 0.0;"
      OutputType=CMOT_Float1
      Description="Overshooting"
      Inputs(0)=(InputName="HC",Input=(Expression="/Script/Engine.MaterialExpressionAdd'MF_ShallowIntegrateVelocity:MaterialExpressionAdd_3'"))
      Inputs(1)=(InputName="VC",Input=(Expression="/Script/Engine.MaterialExpressionMax'MF_ShallowIntegrateVelocity:MaterialExpressionMax_5'"))
      Inputs(2)=(InputName="HL",Input=(Expression="/Script/Engine.MaterialExpressionAdd'MF_ShallowIntegrateVelocity:MaterialExpressionAdd_4'"))
      Inputs(3)=(InputName="VL",Input=(Expression="/Script/Engine.MaterialExpressionMax'MF_ShallowIntegrateVelocity:MaterialExpressionMax_10'"))
      Inputs(4)=(InputName="HR",Input=(Expression="/Script/Engine.MaterialExpressionAdd'MF_ShallowIntegrateVelocity:MaterialExpressionAdd_5'"))
      Inputs(5)=(InputName="VR",Input=(Expression="/Script/Engine.MaterialExpressionMax'MF_ShallowIntegrateVelocity:MaterialExpressionMax_12'"))
      Inputs(6)=(InputName="HB",Input=(Expression="/Script/Engine.MaterialExpressionAdd'MF_ShallowIntegrateVelocity:MaterialExpressionAdd_8'"))
      Inputs(7)=(InputName="VB",Input=(Expression="/Script/Engine.MaterialExpressionMax'MF_ShallowIntegrateVelocity:MaterialExpressionMax_11'"))
