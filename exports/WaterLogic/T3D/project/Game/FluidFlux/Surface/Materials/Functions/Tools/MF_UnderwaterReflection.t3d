   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Materials/Functions/Tools/MF_UnderwaterReflection.MF_UnderwaterReflection:MaterialExpressionCustom_1'"
      Code="float2 result = float2(0.0,0.0);\r\nfloat3 rayPos = WorldPosition;\r\nfloat prevDepth;\r\nfor (int n = 0; n < MaxIterations; n++)\r\n{\r\n\tfloat4 vpPos = mul(float4(rayPos, 1.0f), LWCToFloat(ResolvedView.WorldToClip));\r\n\tfloat2 rayUv = (vpPos.xy / vpPos.w) * float2(0.5,-0.5) + 0.5;\r\n \r\n    float rayDepth = vpPos.w;\r\n    float gbufferDepth = CalcSceneDepth(float2(ViewportUVToBufferUV(rayUv))).x;\r\n   \tDistance = gbufferDepth; //min(gbufferDepth,3000.0);\r\n\t\t \r\n\tfloat depthDiff = rayDepth - gbufferDepth;\r\n\tif (depthDiff > 0 && depthDiff < MaxThickness)\r\n\t{  \r\n\t\treturn lerp(result,rayUv,(0 - prevDepth)/ (depthDiff - prevDepth));\r\n\t}\r\n\tprevDepth = depthDiff;\r\n\tresult = rayUv;\r\n\trayPos += Reflection;\r\n}\r\n//Distance = 100000.0;\r\nreturn result;"
      OutputType=CMOT_Float2
      Description="SSR"
      Inputs(0)=(InputName="WorldPosition",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'MF_UnderwaterReflection:MaterialExpressionWorldPosition_3'"))
      Inputs(1)=(InputName="MaxThickness",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_UnderwaterReflection:MaterialExpressionScalarParameter_2'"))
      Inputs(2)=(InputName="MaxIterations",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_UnderwaterReflection:MaterialExpressionScalarParameter_0'"))
      Inputs(3)=(InputName="Reflection",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_UnderwaterReflection:MaterialExpressionMaterialFunctionCall_1'"))
      AdditionalOutputs(0)=(OutputName="Distance")
      MaterialExpressionEditorX=-4174
      MaterialExpressionEditorY=-1166
      MaterialExpressionGuid=3E17705B44AF822C89FBF79685E74C20
      Function="/Script/Engine.MaterialFunction'MF_UnderwaterReflection'"
      Desc="\n*** Original source before expression upgrade ***\nfloat2 result = float2(0.0,0.0);\r\nfloat3 rayPos = WorldPosition;\r\nfloat prevDepth;\r\nfor (int n = 0; n < MaxIterations; n++)\r\n{\r\n\tfloat4 vpPos = mul(float4(rayPos, 1.0f), View.WorldToClip);\r\n\tfloat2 rayUv = (vpPos.xy / vpPos.w) * float2(0.5,-0.5) + 0.5;\r\n \r\n    float rayDepth = vpPos.w;\r\n    float gbufferDepth = CalcSceneDepth(float2(ViewportUVToBufferUV(rayUv))).x;\r\n   \tDistance = gbufferDepth; //min(gbufferDepth,3000.0);\r\n\t\t \r\n\tfloat depthDiff = rayDepth - gbufferDepth;\r\n\tif (depthDiff > 0 && depthDiff < MaxThickness)\r\n\t{  \r\n\t\treturn lerp(result,rayUv,(0 - prevDepth)/ (depthDiff - prevDepth));\r\n\t}\r\n\tprevDepth = depthDiff;\r\n\tresult = rayUv;\r\n\trayPos += Reflection;\r\n}\r\n//Distance = 100000.0;\r\nreturn result;"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="Distance")
   End Object
