   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Materials/M_FluxCausticsDecal.M_FluxCausticsDecal:MaterialExpressionCustom_0'"
      Code="[branch]\r\nif (Mask > 0.01)\r\n{\r\nOutBaseColor = BaseColor;\r\nOutMetallic = Metallic;\r\nOutSpecular = Specular;\r\nOutRoughness = Roughness;\r\nOutEmissive = Emissive;\r\nreturn Opacity;\r\n} else\r\n{\r\nOutBaseColor =float3(0.0,0.0,0.0);\r\nOutMetallic = 0.0;\r\nOutSpecular = 0.0;\r\nOutRoughness  = 0.0;\r\nOutEmissive =float3(0.0,0.0,0.0);\r\nreturn Opacity;\r\n}\r\n\r\n"
      Description="BranchTest"
      Inputs(0)=(InputName="BaseColor",Input=(Expression="/Script/Engine.MaterialExpressionReroute'M_FluxCausticsDecal:MaterialExpressionReroute_8'"))
      Inputs(1)=(InputName="Metallic",Input=(Expression="/Script/Engine.MaterialExpressionReroute'M_FluxCausticsDecal:MaterialExpressionReroute_9'"))
      Inputs(2)=(InputName="Specular",Input=(Expression="/Script/Engine.MaterialExpressionReroute'M_FluxCausticsDecal:MaterialExpressionReroute_3'"))
      Inputs(3)=(InputName="Roughness",Input=(Expression="/Script/Engine.MaterialExpressionReroute'M_FluxCausticsDecal:MaterialExpressionReroute_11'"))
      Inputs(4)=(InputName="Emissive",Input=(Expression="/Script/Engine.MaterialExpressionReroute'M_FluxCausticsDecal:MaterialExpressionReroute_6'"))
      Inputs(5)=(InputName="Opacity",Input=(Expression="/Script/Engine.MaterialExpressionReroute'M_FluxCausticsDecal:MaterialExpressionReroute_12'"))
      Inputs(6)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'M_FluxCausticsDecal:MaterialExpressionMultiply_0'"))
      AdditionalOutputs(0)=(OutputName="OutBaseColor",OutputType=CMOT_Float3)
      AdditionalOutputs(1)=(OutputName="OutMetallic")
      AdditionalOutputs(2)=(OutputName="OutSpecular")
      AdditionalOutputs(3)=(OutputName="OutRoughness")
      AdditionalOutputs(4)=(OutputName="OutEmissive",OutputType=CMOT_Float3)
      MaterialExpressionEditorX=3056
      MaterialExpressionEditorY=480
      MaterialExpressionGuid=436712B14BC2D902771C64B7AB980962
      Material="/Script/Engine.Material'M_FluxCausticsDecal'"
      bShowOutputNameOnPin=True
