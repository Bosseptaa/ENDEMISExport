   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Lighting/Functions/MF_IntersectionCone.MF_IntersectionCone:MaterialExpressionCustom_0'"
      Code="    float A=dot(origin-lightpos,lightnormal);\r\n    float B=dot(dir,lightnormal);\r\n    float C=dot(origin-lightpos,origin-lightpos);\r\n    float D=dot(dir,dir);\r\n    float E=dot(origin-lightpos,dir);\r\n\r\n    float a=B*B-k*k*D;\r\n    float b=2.*(A*B-k*k*E);\r\n    float c=A*A-k*k*C;\r\n    float t1,t2;\r\n    \r\n    float delta=b*b-4.*a*c;\r\n    if(delta<0.) return 0.0;\r\n    float temp1=-b/(2.*a);\r\n    float temp2=sqrt(delta)/(2.*a);\r\n\r\n    t1=temp1-temp2;\r\n    t2=temp1+temp2;\r\n\r\n    tmin=min(t1,t2);\r\n    tmax=max(t1,t2);\r\n    return 1.0;"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="origin",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'MF_IntersectionCone:MaterialExpressionCameraPositionWS_0'"))
      Inputs(1)=(InputName="dir",Input=(Expression="/Script/Engine.MaterialExpressionCameraVectorWS'MF_IntersectionCone:MaterialExpressionCameraVectorWS_0'"))
      Inputs(2)=(InputName="lightnormal",Input=(Expression="/Script/Engine.MaterialExpressionNormalize'MF_IntersectionCone:MaterialExpressionNormalize_0'"))
      Inputs(3)=(InputName="lightpos",Input=(Expression="/Script/Engine.MaterialExpressionConstant3Vector'MF_IntersectionCone:MaterialExpressionConstant3Vector_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(4)=(InputName="k",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_IntersectionCone:MaterialExpressionConstant_2'"))
      AdditionalOutputs(0)=(OutputName="tmin")
      AdditionalOutputs(1)=(OutputName="tmax")
      MaterialExpressionEditorX=160
      MaterialExpressionEditorY=-16
      MaterialExpressionGuid=439D5DC346BB44917B2A9FA066370941
      Function="/Script/Engine.MaterialFunction'MF_IntersectionCone'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="tmin")
      Outputs(2)=(OutputName="tmax")
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Lighting/Functions/MF_IntersectionCone.MF_IntersectionCone:MaterialExpressionCustom_1'"
      Code="    float3  ba = pb - pa;\r\n    float3  oa = ro - pa;\r\n    float3  ob = ro - pb;\r\n    \r\n    float m0 = dot(ba,ba);\r\n    float m1 = dot(oa,ba);\r\n    float m2 = dot(ob,ba); \r\n    float m3 = dot(rd,ba);\r\n \r\n    //caps\r\n\t\r\n\tfloat3 dA = oa*m3-rd*m1;\r\n\tfloat3 dB = ob*m3-rd*m2;\r\n\t\r\n         if( m1<0.0 ) { if( dot(dA, dA)<(ra*ra*m3*m3) ) return float2(-m1/m3,-ba*rsqrt(m0)); }\r\n    else if( m2>0.0 ) { if( dot(dB, dB)<(rb*rb*m3*m3) ) return float2(-m2/m3, ba*rsqrt(m0)); }\r\n    \r\n    // body\r\n    float rr = ra - rb;\r\n    float hy = m0 + rr*rr;\r\n    float m4 = dot(rd,oa);\r\n    float m5 = dot(oa,oa);\r\n    \r\n    float k2 = m0*m0    - m3*m3*hy;\r\n    float k1 = m0*m0*m4 - m1*m3*hy + m0*ra*(rr*m3*1.0        );\r\n    float k0 = m0*m0*m5 - m1*m1*hy + m0*ra*(rr*m1*2.0 - m0*ra);\r\n    \r\n    float h = k1*k1 - k2*k0;\r\n    if( h<0.0 ) return float2(-1.0);\r\n\r\n    float t = (-k1-sqrt(h))/k2;\r\n\r\n    float y = m1 + t*m3;\r\n    if( y>0.0 && y<m0 ) \r\n    {\r\n        return float2(t, normalize(m0*(m0*(oa+t*rd)+rr*ba*ra)-ba*hy*y));\r\n    }\r\n    \r\n    return float2(-1.0);"
      OutputType=CMOT_Float2
      Inputs(0)=(InputName="ro",Input=(Expression="/Script/Engine.MaterialExpressionCameraPositionWS'MF_IntersectionCone:MaterialExpressionCameraPositionWS_0'"))
      Inputs(1)=(InputName="rd",Input=(Expression="/Script/Engine.MaterialExpressionCameraVectorWS'MF_IntersectionCone:MaterialExpressionCameraVectorWS_0'"))
      Inputs(2)=(InputName="pa",Input=(Expression="/Script/Engine.MaterialExpressionConstant3Vector'MF_IntersectionCone:MaterialExpressionConstant3Vector_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="pb",Input=(Expression="/Script/Engine.MaterialExpressionAdd'MF_IntersectionCone:MaterialExpressionAdd_0'"))
      Inputs(4)=(InputName="ra",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_IntersectionCone:MaterialExpressionConstant_0'"))
      Inputs(5)=(InputName="rb",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_IntersectionCone:MaterialExpressionConstant_1'"))
      MaterialExpressionEditorX=464
      MaterialExpressionEditorY=256
      MaterialExpressionGuid=BC5874EC455DBD9339D6C380AFA4517E
      Function="/Script/Engine.MaterialFunction'MF_IntersectionCone'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Lighting/Functions/MF_IntersectionCone.MF_IntersectionCone:MaterialExpressionCustom_2'"
      Code="\t\r\n\t\r\n\t\t// scale and offset into a unit cube\r\n\torg.x += 0.5;\r\n\tfloat s = 0.5;\r\n\torg.x *= s;\r\n\tdir.x *= s;\r\n\t\r\n\t// quadratic x^2 = y^2 + z^2\r\n\tfloat a = dir.y * dir.y + dir.z * dir.z - dir.x * dir.x;\r\n\tfloat b = org.y * dir.y + org.z * dir.z - org.x * dir.x;\r\n\tfloat c = org.y * org.y + org.z * org.z - org.x * org.x;\r\n\t\r\n\tfloat cap = (s - org.x) / dir.x;\r\n \r\n\t// linear\r\n\tif( a == 0.0 )\r\n\t{\r\n\t\tnear = -0.5 * c/b;\r\n\t\tfloat x = org.x + near * dir.x;\r\n\t\tif( x < 0.0 || x > s )\r\n\t\t\treturn 0.0; \r\n\r\n\t\tfar = cap;\r\n\t\tfloat temp = min(far, near); \r\n\t\tfar = max(far, near);\r\n\t\tnear = temp;\r\n\r\n\t\tif (far < 0.0) return 0.0;\r\n\r\n\t}\r\n\r\n\tfloat delta = b * b - a * c;\r\n\tif( delta < 0.0 )\r\n\t\treturn 0.0;\r\n\r\n\t// 2 roots\r\n\tfloat deltasqrt = sqrt(delta);\r\n\tfloat arcp = 1.0 / a;\r\n\tnear = (-b - deltasqrt) * arcp;\r\n\tfar = (-b + deltasqrt) * arcp;\r\n\t\r\n\t// order roots\r\n\tfloat temp = min(far, near);\r\n\tfar = max(far, near);\r\n\tnear = temp;\r\n\r\n\tfloat xnear = org.x + near * dir.x;\r\n\tfloat xfar = org.x + far * dir.x;\r\n\r\n\tif( xnear < 0.0 )\r\n\t{\r\n\t\tif( xfar < 0.0 || xfar > s )\r\n\t\t\treturn 0.0;\r\n\t\t\r\n\t\tnear = far;       \r\n\t\tfar = cap;\r\n\t}\r\n\telse if( xnear > s )\r\n\t{\r\n\t\tif( xfar < 0.0 || xfar > s )\r\n\t\t\treturn 0.0;\r\n\t\t\r\n\t\tnear = cap;  \r\n\t}\r\n\telse if( xfar < 0.0 )\r\n\t{\r\n\t\t// The apex is problematic,\r\n\t\t// additional checks needed to\r\n\t\t// get rid of the blinking tip here.\r\n\t\tfar = near;\r\n\t\tnear = cap;\r\n\t}\r\n\telse if( xfar > s )\r\n\t{\r\n\t\tfar = cap;\r\n\t}\r\n \tnear = max(near, 0.0);\r\n\tif  (far <= 0.0)  return 0.0;\r\nreturn 1.0;"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="org",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_IntersectionCone:MaterialExpressionFunctionInput_8'"))
      Inputs(1)=(InputName="dir",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_IntersectionCone:MaterialExpressionFunctionInput_9'"))
      AdditionalOutputs(0)=(OutputName="near")
      AdditionalOutputs(1)=(OutputName="far")
      MaterialExpressionEditorX=-64
      MaterialExpressionEditorY=692
      MaterialExpressionGuid=3616A9004D8FEF30CB35AB8AA239A34D
      Function="/Script/Engine.MaterialFunction'MF_IntersectionCone'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="near")
      Outputs(2)=(OutputName="far")
   End Object
