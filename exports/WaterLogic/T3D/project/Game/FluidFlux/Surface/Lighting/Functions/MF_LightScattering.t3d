   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Lighting/Functions/MF_LightScattering.MF_LightScattering:MaterialExpressionCustom_0'"
      Code="int3 randpos = int3(Parameters.SvPosition.xy, View.StateFrameIndexMod8);\r\nreturn float(Rand3DPCG16(randpos).x)/0xffff;"
      OutputType=CMOT_Float1
      Description="CheapDither"
      Inputs=
      MaterialExpressionEditorX=272
      MaterialExpressionEditorY=992
      MaterialExpressionGuid=1E993C5445744FD1F930B5886A1D56CB
      Function="/Script/Engine.MaterialFunction'MF_LightScattering'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Lighting/Functions/MF_LightScattering.MF_LightScattering:MaterialExpressionCustom_1'"
      Code="struct Functions\r\n{\r\nfloat henyey_greenstein_phase_func(float mu, float g)\r\n{\r\n\t#define PI 3.14159265359\r\n\treturn\r\n\t\t\t\t\t\t(1. - g*g)\r\n\t/ //---------------------------------------------\r\n\t\t((4. * PI) * pow(1. + g*g - 2.*g*mu, 1.5));\r\n}\r\n\r\nfloat getsuncolor(float3 origin, float3 dir, float3 lightpos,float3 lightnormal)\r\n{\r\n\t/*\r\n    float t;\r\n    float2 intersect = raycast(origin, dir, t);\r\n    if(intersect.x > -500.0) \r\n        return 0.0;*/\r\n \r\n    float scale = 1.0;\r\n  \r\n    if (-dot(dir, lightnormal) < 0.96)\r\n        scale = clamp((-dot(dir, lightnormal) - 0.9) * 30.0, 0.0, 1.0);\r\n  \r\n   //   return exp(-length(lightpos - origin) * density * extincting);\r\n  //  return scale * 0.01/pow(length(lightpos - origin), 2.0);//  * max(-dot(dir, lightnormal) * 5.0-3.5, 0.0);\r\n\t\r\n\tfloat distance = length(lightpos - origin);\r\n\tfloat distanceFade = saturate(1.0 - distance  /4000.0); \r\n\t\r\n\t return   distanceFade * (1000.0 / max(distance-250.0, 250.0));\r\n\t\r\n}\r\n\r\n};\r\n\r\nFunctions f;\r\nfloat RayStepSize = (tmax - tmin) / float(raysteps);\r\nfloat CurrentDepth = tmin + dither * RayStepSize;\r\nfloat stepdensity = density * RayStepSize;\r\n\r\nfloat Transmittance = 1.;\r\nfloat3 Illumination = float3(0.0 ,0.0, 0.0);\r\n\r\nfor(int i=0; i < raysteps; i++)\r\n{\t\r\n\tfloat3 samplePosition = origin + dir * CurrentDepth;\r\n\tCurrentDepth += RayStepSize;\r\n\t\r\n\tfloat3 SampleToLightDirection = normalize(lightpos - samplePosition);\r\n\r\n\tfloat phase = f.henyey_greenstein_phase_func( dot(SampleToLightDirection, dir) , gp);\r\n\t\r\n\t\r\n\tfloat3 sampleLocal = samplePosition / lightSize;\r\n\tfloat3 tex = Texture2DSample(tex_in, tex_inSampler, sampleLocal.yz / (sampleLocal.x) -0.5);\r\n \r\n\tfloat attenuation = (1.0 - sampleLocal.x);\r\n\tfloat LightShadow = tex.x * attenuation * attenuation;\r\n \r\n\t\r\n\t//float LightShadow = samplerColor.r; //f.getsuncolor(samplePosition, SampleToLightDirection, lightpos, lightnormal);\r\n\tfloat InOutScattering = (indirectLight + directLight * phase) * LightShadow * scatteringfactor;\r\n\r\n\tTransmittance *= exp(-stepdensity * extincting);\r\n\tIllumination += stepdensity * Transmittance * InOutScattering;\t\r\n}\r\n\r\nreturn Illumination * Transmittance;\r\n"
      Description="DirectionalLightScattering"
      Inputs(0)=(InputName="tmin",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_LightScattering:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="tmax",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_LightScattering:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="raysteps",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_LightScattering:MaterialExpressionScalarParameter_12'"))
      Inputs(3)=(InputName="dir",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_LightScattering:MaterialExpressionFunctionInput_2'"))
      Inputs(4)=(InputName="origin",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_LightScattering:MaterialExpressionFunctionInput_3'"))
      Inputs(5)=(InputName="lightnormal",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_LightScattering:MaterialExpressionFunctionInput_4'"))
      Inputs(6)=(InputName="lightpos",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_LightScattering:MaterialExpressionFunctionInput_6'"))
      Inputs(7)=(InputName="density",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_LightScattering:MaterialExpressionScalarParameter_0'"))
      Inputs(8)=(InputName="scatteringfactor",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_LightScattering:MaterialExpressionScalarParameter_13'"))
      Inputs(9)=(InputName="extincting",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_LightScattering:MaterialExpressionScalarParameter_14'"))
      Inputs(10)=(InputName="directLight",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_LightScattering:MaterialExpressionScalarParameter_15'"))
      Inputs(11)=(InputName="indirectLight",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_LightScattering:MaterialExpressionScalarParameter_1'"))
      Inputs(12)=(InputName="gp",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_LightScattering:MaterialExpressionScalarParameter_2'"))
      Inputs(13)=(InputName="tex_in",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_LightScattering:MaterialExpressionFunctionInput_5'"))
      Inputs(14)=(InputName="dither",Input=(Expression="/Script/Engine.MaterialExpressionCustom'MF_LightScattering:MaterialExpressionCustom_0'"))
      Inputs(15)=(InputName="lightSize",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'MF_LightScattering:MaterialExpressionMultiply_7'"))
      MaterialExpressionEditorX=720
      MaterialExpressionEditorY=80
      MaterialExpressionGuid=1C4DCD9241EC6D3D15905D9B329043C1
      Function="/Script/Engine.MaterialFunction'MF_LightScattering'"
   End Object
   Begin Object Name="MaterialExpressionDivide_0" ExportPath="/Script/Engine.MaterialExpressionDivide'/Game/FluidFlux/Surface/Lighting/Functions/MF_LightScattering.MF_LightScattering:MaterialExpressionDivide_0'"
      A=(Expression="/Script/Engine.MaterialExpressionSubtract'MF_LightScattering:MaterialExpressionSubtract_0'")
      ConstB=100.000000
