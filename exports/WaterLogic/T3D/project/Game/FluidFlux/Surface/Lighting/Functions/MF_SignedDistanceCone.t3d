      ExpressionCollection=(Expressions=("/Script/Engine.MaterialExpressionFunctionOutput'MF_SignedDistanceCone:MaterialExpressionFunctionOutput_0'","/Script/Engine.MaterialExpressionCustom'MF_SignedDistanceCone:MaterialExpressionCustom_0'","/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_0'","/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_1'","/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_2'","/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_3'","/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_4'"))
