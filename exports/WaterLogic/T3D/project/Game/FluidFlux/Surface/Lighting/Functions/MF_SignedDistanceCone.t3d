   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Lighting/Functions/MF_SignedDistanceCone.MF_SignedDistanceCone:MaterialExpressionCustom_0'"
      Code="    float rba  = rb-ra;\r\n    float baba = dot(b-a,b-a);\r\n    float papa = dot(p-a,p-a);\r\n    float paba = dot(p-a,b-a)/baba;\r\n\r\n    float x = sqrt( papa - paba*paba*baba );\r\n\r\n    float cax = max(0.0,x-((paba<0.5)?ra:rb));\r\n    float cay = abs(paba-0.5)-0.5;\r\n\r\n    float k = rba*rba + baba;\r\n    float f = clamp( (rba*(x-ra)+paba*baba)/k, 0.0, 1.0 );\r\n\r\n    float cbx = x-ra - f*rba;\r\n    float cby = paba - f;\r\n    \r\n    float s = (cbx < 0.0 && cay < 0.0) ? -1.0 : 1.0;\r\n    \r\n    return s*sqrt( min(cax*cax + cay*cay*baba,\r\n                       cbx*cbx + cby*cby*baba) );\r\n"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="ra",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="rb",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="a",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_2'"))
      Inputs(3)=(InputName="b",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_3'"))
      Inputs(4)=(InputName="p",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SignedDistanceCone:MaterialExpressionFunctionInput_4'"))
      MaterialExpressionEditorX=-112
      MaterialExpressionEditorY=352
      MaterialExpressionGuid=E4A56D3A479635C1C30F8FB483964DA9
      Function="/Script/Engine.MaterialFunction'MF_SignedDistanceCone'"
   End Object
