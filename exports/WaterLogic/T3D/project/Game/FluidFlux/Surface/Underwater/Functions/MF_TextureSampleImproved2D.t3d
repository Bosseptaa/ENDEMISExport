   Begin Object Name="MaterialExpressionConstant_3" ExportPath="/Script/Engine.MaterialExpressionConstant'/Game/FluidFlux/Surface/Underwater/Functions/MF_TextureSampleImproved2D.MF_TextureSampleImproved2D:MaterialExpressionConstant_3'"
      R=1.000000
      MaterialExpressionEditorX=1030
      MaterialExpressionEditorY=1215
      MaterialExpressionGuid=B6A4D034429D3AA2F09AC9AA1E0B2AEE
      Function="/Script/Engine.MaterialFunction'MF_TextureSampleImproved2D'"
