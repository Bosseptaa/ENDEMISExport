   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Underwater/Functions/MF_TextureSampleImproved2D.MF_TextureSampleImproved2D:MaterialExpressionCustom_0'"
      Code="uint2 res;\r\nTex.GetDimensions(res.x, res.y) ;\r\n res /=(1+Lod);\r\n\r\nfloat2 st = uv*res - 0.5;\r\n\r\nfloat2 iuv = floor( st );\r\nfloat2 fuv = frac( st );\r\n\r\nfloat4 a = Texture2DSampleLevel(Tex, TexSampler, (iuv+float2(0.5,0.5))/res, Lod);\r\nfloat4 b = Texture2DSampleLevel(Tex, TexSampler,(iuv+float2(1.5,0.5))/res, Lod);\r\nfloat4 c = Texture2DSampleLevel(Tex, TexSampler,(iuv+float2(0.5,1.5))/res, Lod);\r\nfloat4 d = Texture2DSampleLevel(Tex, TexSampler,(iuv+float2(1.5,1.5))/res, Lod);\r\n fuv = fuv*fuv*fuv*(fuv*(fuv*6.0-15.0)+10.0);\r\n\r\nreturn lerp( lerp( a, b, fuv.x),\r\n\t\t\tlerp( c, d, fuv.x), fuv.y );\r\n\t\t\t"
      OutputType=CMOT_Float4
      Description="CustomSample"
      Inputs(0)=(InputName="uv",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'MF_TextureSampleImproved2D:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObject'MF_TextureSampleImproved2D:MaterialExpressionTextureObject_1'"))
      Inputs(2)=(InputName="Lod",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_TextureSampleImproved2D:MaterialExpressionConstant_3'"))
      MaterialExpressionEditorX=1168
      MaterialExpressionEditorY=1104
      MaterialExpressionGuid=132C220E45151E72BDC5DBBE23E8326D
      Function="/Script/Engine.MaterialFunction'MF_TextureSampleImproved2D'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Underwater/Functions/MF_TextureSampleImproved2D.MF_TextureSampleImproved2D:MaterialExpressionCustom_1'"
      Code="uint2 res =  Tex.GetDimensions(res.x, res.y);\r\n  return Tex.Load(int3(coords* res));"
      OutputType=CMOT_Float4
      Inputs(0)=(InputName="coords",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'MF_TextureSampleImproved2D:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObject'MF_TextureSampleImproved2D:MaterialExpressionTextureObject_1'"))
      MaterialExpressionEditorX=1168
      MaterialExpressionEditorY=896
      MaterialExpressionGuid=132C220E45151E72BDC5DBBE23E8326D
      Function="/Script/Engine.MaterialFunction'MF_TextureSampleImproved2D'"
   End Object
