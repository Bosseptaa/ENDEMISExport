      Code="uint2 res;\r\nTex.GetDimensions(res.x, res.y);\r\n \r\nfloat2 st = uv*res - 0.5;\r\n\r\nfloat2 iuv = floor( st );\r\nfloat2 fuv = frac( st );\r\n\r\nfloat4 a = Texture2DSampleLevel(Tex, TexSampler, (iuv+float2(0.5,0.5))/res, 0);\r\nfloat4 b = Texture2DSampleLevel(Tex, TexSampler,(iuv+float2(1.5,0.5))/res, 0);\r\nfloat4 c = Texture2DSampleLevel(Tex, TexSampler,(iuv+float2(0.5,1.5))/res, 0);\r\nfloat4 d = Texture2DSampleLevel(Tex, TexSampler,(iuv+float2(1.5,1.5))/res, 0);\r\n \r\n\r\n//fuv = fuv*fuv*fuv*(fuv*(fuv*6.0-15.0)+10.0);\r\n  \r\n dir =  normalize( cross(float3(1.0,1.0,a.x-d.x), float3(1.0,-1.0,c.x-b.x)));\r\n\t\t\t\r\nreturn lerp( lerp( a, b, fuv.x),\r\n\t\t\tlerp( c, d, fuv.x), fuv.y );"
      OutputType=CMOT_Float4
      Description="CustomSample"
      Inputs(0)=(InputName="uv")
      Inputs(1)=(InputName="Tex")
      Inputs(2)=(InputName="Lod",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_TextureSamplePrecise3D:MaterialExpressionConstant_3'"))
      AdditionalOutputs(0)=(OutputName="dir",OutputType=CMOT_Float3)
      MaterialExpressionEditorX=560
      MaterialExpressionEditorY=560
      MaterialExpressionGuid=132C220E45151E72BDC5DBBE23E8326D
      Function="/Script/Engine.MaterialFunction'MF_TextureSamplePrecise3D'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="dir")
   End Object
