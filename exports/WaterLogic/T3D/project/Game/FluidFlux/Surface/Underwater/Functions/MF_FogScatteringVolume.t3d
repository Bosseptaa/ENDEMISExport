   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Underwater/Functions/MF_FogScatteringVolume.MF_FogScatteringVolume:MaterialExpressionCustom_2'"
      Code="\tconst float k = 1.55f * g - 0.55f * g * g * g;\r\n\tconst float SchlickPhaseFactor = 1.0f + k * CosTheta;\r\n\tconst float PhaseValue = (1.0f - k * k) / (4.0f * PI * SchlickPhaseFactor * SchlickPhaseFactor);\r\n\treturn PhaseValue;"
      OutputType=CMOT_Float1
