   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Surface/Underwater/Functions/MF_FogScatteringVolume.MF_FogScatteringVolume:MaterialExpressionCustom_1'"
      Code="float DirScattLuminancePhase = PhaseG;\r\nfloat3 AmbIsotropicPhase = AmbientPhase / (4.0f * PI);\r\n\r\nfloat DirectionalLightShadow = 1.0;\r\n\r\nfloat3 SunIlluminance = ResolvedView.DirectionalLightColor.rgb* DirectionalLightShadow * PI;\r\n\r\nfloat3 ExtinctionCoeff = ScatteringCoeff + AbsorptionCoeff;\r\nfloat3 ExtinctionCoeffSafe = max(ScatteringCoeff + AbsorptionCoeff, 1e-5); \r\n \r\nfloat3 Transmittance = exp(-ExtinctionCoeff * BehindWaterDeltaDepth);\r\nfloat3 LuminanceCoeff = (ScatteringCoeff / ExtinctionCoeffSafe) * (1.0 - Transmittance);\r\nfloat3 ScatteredLuminance = LuminanceCoeff * (AmbientIlluminance + ((AmbIsotropicPhase + DirScattLuminancePhase ) * SunIlluminance));\r\n \r\nFogAbsorption = Transmittance;\r\nFogColor = ScatteredLuminance;//* ResolvedView.OneOverPreExposure;\r\nFogAlpha = dot(ScatteredLuminance, 0.3333);\r\nreturn 0;\r\n"
      Description="SLWUnderwater"
      Inputs(0)=(InputName="ScatteringCoeff",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_FogScatteringVolume:MaterialExpressionMaterialFunctionCall_3'",OutputIndex=6))
      Inputs(1)=(InputName="AbsorptionCoeff",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_FogScatteringVolume:MaterialExpressionMaterialFunctionCall_3'",OutputIndex=7))
      Inputs(2)=(InputName="PhaseG",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'MF_FogScatteringVolume:MaterialExpressionMultiply_2'"))
      Inputs(3)=(InputName="AmbientPhase",Input=(Expression="/Script/Engine.MaterialExpressionMax'MF_FogScatteringVolume:MaterialExpressionMax_2'"))
