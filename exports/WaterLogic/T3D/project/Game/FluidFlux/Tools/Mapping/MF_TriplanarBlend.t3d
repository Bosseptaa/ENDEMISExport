   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/Mapping/MF_TriplanarBlend.MF_TriplanarBlend:MaterialExpressionCustom_0'"
      Code="if (Weights.x > Weights.y)\r\n{\r\n\tif (Weights.z > Weights.x)\r\n\t{\r\n\t\treturn ZUV;\r\n\t} else\r\n\t{\r\n\t \treturn XUV;\r\n\t}\r\n} else\r\n{\r\n\tif (Weights.z > Weights.y)\r\n\t{\r\n\t\treturn ZUV;\r\n\t} else\r\n\t{\r\n\t \treturn YUV;\r\n\t}\r\n\r\n}"
      OutputType=CMOT_Float2
      Inputs(0)=(InputName="Weights")
      Inputs(1)=(InputName="XUV")
      Inputs(2)=(InputName="YUV")
      Inputs(3)=(InputName="ZUV")
      MaterialExpressionEditorX=896
      MaterialExpressionEditorY=976
      MaterialExpressionGuid=A7CD609D4596ED5B0AD25F96D43A9ADB
      Function="/Script/Engine.MaterialFunction'MF_TriplanarBlend'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/Mapping/MF_TriplanarBlend.MF_TriplanarBlend:MaterialExpressionCustom_1'"
      Code="if (Weights.x > Weights.y)\r\n{\r\n\t \treturn XUV;\r\n} else\r\n{\r\n\t \treturn YUV;\r\n}"
