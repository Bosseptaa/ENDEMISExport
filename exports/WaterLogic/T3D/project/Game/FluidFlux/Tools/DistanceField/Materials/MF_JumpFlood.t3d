   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Materials/MF_JumpFlood.MF_JumpFlood:MaterialExpressionCustom_0'"
      Code="    float bestDist = 65535.0;\r\n\tfloat2 bestSeed = Texture2DSample(inTexture, inTextureSampler, texelPosition / textureSize).xy;\r\n    float sdfSign = sign(bestSeed.x);\r\n\tfloat2 adjustScale = float2(1.0, 1.0);// float2(1.0, textureSize.x/textureSize.y);\r\n    for(int i = -1;i <= 1;i++)\r\n    {\r\n        for(int j = -1;j <= 1;j++)\r\n        {\r\n            float2 curUV = texelPosition + float2(i,j) * stepLength;\r\n            float2 seedPosition = abs(Texture2DSample(inTexture, inTextureSampler, curUV / textureSize).xy);\r\n\t\t\t\r\n\t\t\tif (all(seedPosition != float2(0.0, 0.0)))\r\n\t\t\t{\r\n\t\t\t\tfloat curDist = length((seedPosition.xy - texelPosition) * adjustScale);\r\n\t\t\t\tif (bestDist > curDist)\r\n\t\t\t\t{\r\n\t\t\t\t\tbestSeed = seedPosition;\r\n\t\t\t\t\tbestDist = curDist;\r\n\t\t\t\t}\r\n\t\t\t}\r\n        }\r\n    }\r\n    \r\n    return float2(abs(bestSeed) * sdfSign);\r\n\t\r\n\t"
      OutputType=CMOT_Float2
      Description="JumpFlood"
      Inputs(0)=(InputName="inTexture",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_JumpFlood:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="textureSize",Input=(Expression="/Script/Engine.MaterialExpressionTextureProperty'MF_JumpFlood:MaterialExpressionTextureProperty_0'"))
      Inputs(2)=(InputName="texelPosition",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_JumpFlood:MaterialExpressionFunctionInput_1'"))
      Inputs(3)=(InputName="stepLength",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_JumpFlood:MaterialExpressionFunctionInput_2'"))
      MaterialExpressionEditorX=-80
      MaterialExpressionEditorY=336
      MaterialExpressionGuid=9B80D5064D05E18D4AD9679A739CC8BE
      Function="/Script/Engine.MaterialFunction'MF_JumpFlood'"
      Desc="texelPosition is center of texel (include half-texel offset)"
      bRealtimePreview=True
   End Object
