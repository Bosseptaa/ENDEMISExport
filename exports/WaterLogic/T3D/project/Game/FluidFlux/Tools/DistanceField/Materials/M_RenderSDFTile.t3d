   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Materials/M_RenderSDFTile.M_RenderSDFTile:MaterialExpressionCustom_5'"
      Code="\t\r\n\t\r\nfloat minDist = 10000000.0; //(MaxRadius + 1) * (MaxRadius + 1);\r\n\r\nint MaxRadius = Quality * Width;\r\n\r\nfloat2 texelsize = 1.0f / (TextureSize * Quality);\r\nfloat StartSample = Tex.SampleLevel(TexSampler, UV, 0).r - Clip;\r\nfloat Direction =  (StartSample < 0.0) ? -1.0 : 1.0;\r\n\r\nfloat2 adjustScale = float2(1.0, TextureSize.x/TextureSize.y);\r\n\r\nfor(int i = -MaxRadius; i < MaxRadius; i++)\r\n{\r\n    for(int j = -MaxRadius; j < MaxRadius; j++)\r\n    {\r\n        float2 TextureOffset = float2((float)i, float(j));\t\t\r\n        float CurentSample = (Tex.SampleLevel(TexSampler, UV + texelsize * TextureOffset, 0).r - Clip) * Direction;\r\n        if( ( CurentSample < 0.0) )\r\n        {\r\n\t\t\tfloat newdist = dot(TextureOffset, TextureOffset);\r\n\t\t\tif (newdist < minDist)\r\n\t\t\t{\r\n\t\t\t\tminDist = newdist;\r\n\t\t\t}\r\n        }\r\n    }\r\n}\r\n \r\nreturn sqrt(minDist) * Direction;\r\n\r\n "
      OutputType=CMOT_Float1
      Description="CalulateEdgeDirections"
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_RenderSDFTile:MaterialExpressionTextureObjectParameter_5'"))
      Inputs(1)=(InputName="TextureSize",Input=(Expression="/Script/Engine.MaterialExpressionTextureProperty'M_RenderSDFTile:MaterialExpressionTextureProperty_4'"))
      Inputs(2)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_RenderSDFTile:MaterialExpressionTextureCoordinate_5'"))
      Inputs(3)=(InputName="Width",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_RenderSDFTile:MaterialExpressionScalarParameter_8'"))
      Inputs(4)=(InputName="Clip",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_RenderSDFTile:MaterialExpressionScalarParameter_1'"))
      Inputs(5)=(InputName="Quality",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_RenderSDFTile:MaterialExpressionScalarParameter_9'"))
      MaterialExpressionEditorX=-416
      MaterialExpressionEditorY=-2576
      MaterialExpressionGuid=50B76CC4466A04484C7F4492E54268D1
      Material="/Script/Engine.Material'M_RenderSDFTile'"
      bCollapsed=True
   End Object
