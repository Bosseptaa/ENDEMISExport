      Code="int MaxRadius = 32;\r\nfloat2 texelsize = 0.5f / TextureSize;\t\r\nfloat minDist = 10000.0; \r\nfloat maxDist = -10000.0; \r\nfor(int i = -MaxRadius; i < MaxRadius; i++)\r\n{\r\n    for(int j = -MaxRadius; j < MaxRadius; j++)\r\n    {\r\n\t\tfloat2 NewUV = UV + texelsize * float2((float)i, float(j));\t\r\n\t\tfloat depth = Tex.SampleLevel(TexSampler, NewUV, 0).r;\r\n\t\t\r\n\t\tfloat2 ProjectionUV = (NewUV - 0.5) * Size.xy;\r\n\t\tfloat3 SurfacePosition = \r\n\t\t\tPosition + \r\n\t\t\tdepth * Front + \r\n\t\t\tProjectionUV.x * Right + \r\n\t\t\tProjectionUV.y * Up;\r\n\t\t\t\t\r\n\t    float proj = dot(Front, SurfacePosition - WorldPosition);\r\n\t\tif (SampleDepth > 0.0)\r\n\t\t{\t\r\n\t\t\tif (proj > 0.0)\r\n\t\t\t   SurfacePosition -= proj * Front;\r\n\t\t} else\r\n\t\t{\r\n\t\t\tif (proj < 0.0)\r\n\t\t\t   SurfacePosition -= proj * Front;\t\t\r\n\t\t}\r\n\t\t\r\n\t\tfloat distance = length(WorldPosition - SurfacePosition);\r\n \t\tminDist = min(minDist, distance);\r\n    }\r\n}\r\n\r\nreturn minDist * sign(SampleDepth);\r\n"
      OutputType=CMOT_Float1
      Description="DisatnceToSurface"
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'MF_SDFHeightmapSample:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(1)=(InputName="TextureSize",Input=(Expression="/Script/Engine.MaterialExpressionTextureProperty'MF_SDFHeightmapSample:MaterialExpressionTextureProperty_0'"))
      Inputs(2)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'MF_SDFHeightmapSample:MaterialExpressionNamedRerouteUsage_2'"))
      Inputs(3)=(InputName="Front",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'MF_SDFHeightmapSample:MaterialExpressionVectorParameter_13'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(4)=(InputName="Up",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'MF_SDFHeightmapSample:MaterialExpressionVectorParameter_11'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(5)=(InputName="Right",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'MF_SDFHeightmapSample:MaterialExpressionVectorParameter_7'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(6)=(InputName="Position",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'MF_SDFHeightmapSample:MaterialExpressionVectorParameter_4'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(7)=(InputName="WorldPosition",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SDFHeightmapSample:MaterialExpressionFunctionInput_0'"))
      Inputs(8)=(InputName="Size",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'MF_SDFHeightmapSample:MaterialExpressionVectorParameter_6'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(9)=(InputName="SampleDepth",Input=(Expression="/Script/Engine.MaterialExpressionSubtract'MF_SDFHeightmapSample:MaterialExpressionSubtract_3'"))
      MaterialExpressionEditorX=-256
      MaterialExpressionEditorY=416
      MaterialExpressionGuid=5033BCDB46D3A6645D62E6967AD5389F
      Function="/Script/Engine.MaterialFunction'MF_SDFHeightmapSample'"
      bCollapsed=True
   End Object
