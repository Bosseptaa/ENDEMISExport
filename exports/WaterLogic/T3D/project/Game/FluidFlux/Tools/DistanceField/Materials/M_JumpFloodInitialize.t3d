   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Materials/M_JumpFloodInitialize.M_JumpFloodInitialize:MaterialExpressionCustom_5'"
      Code="\t\r\n\t\r\nfloat minDist = 10000000.0; //(MaxRadius + 1) * (MaxRadius + 1);\r\n\r\nint MaxRadius = Quality * Width;\r\n\r\nfloat2 texelsize = 1.0f / (TextureSize * Quality);\r\nfloat StartSample = Tex.SampleLevel(TexSampler, UV, 0).r - Clip;\r\nfloat Direction =  (StartSample < 0.0) ? -1.0 : 1.0;\r\nfloat2 minOffset = float2(65535,65535);\r\nfloat2 adjustScale = float2(1.0, TextureSize.x/TextureSize.y);\r\n\r\nfor(int i = -MaxRadius; i < MaxRadius; i++)\r\n{\r\n    for(int j = -MaxRadius; j < MaxRadius; j++)\r\n    {\r\n        float2 TextureOffset = float2((float)i, float(j));\t\t\r\n        float CurentSample = (Tex.SampleLevel(TexSampler, UV + texelsize * TextureOffset, 0).r - Clip) * Direction;\r\n        if( ( CurentSample < 0.0) )\r\n        {\r\n\t\t\tfloat newdist = dot(TextureOffset,TextureOffset);\r\n\t\t\tif (newdist < minDist)\r\n\t\t\t{\r\n\t\t\t\tminDist = newdist;\r\n\t\t\t\tminOffset = TextureOffset;\r\n\t\t\t}\r\n        }\r\n    }\r\n}\r\n Direction /= adjustScale;\r\n if (minDist < 10000000.0)\r\n {\r\n\treturn -(UV + texelsize * minOffset) * Direction * TextureSize;\r\n } else\r\n {\r\n\treturn -minOffset * Direction;\r\n }\r\n\r\n// 0.5 + Direction * 0.5 * (0.5 - sqrt(minDist))/ MaxRadius;"
      OutputType=CMOT_Float2
      Description="CalulateEdgeDirections"
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_JumpFloodInitialize:MaterialExpressionTextureObjectParameter_1'"))
      Inputs(1)=(InputName="TextureSize",Input=(Expression="/Script/Engine.MaterialExpressionTextureProperty'M_JumpFloodInitialize:MaterialExpressionTextureProperty_0'"))
      Inputs(2)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_JumpFloodInitialize:MaterialExpressionTextureCoordinate_4'"))
      Inputs(3)=(InputName="Width",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_JumpFloodInitialize:MaterialExpressionScalarParameter_8'"))
      Inputs(4)=(InputName="Clip",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_JumpFloodInitialize:MaterialExpressionScalarParameter_0'"))
      Inputs(5)=(InputName="Quality",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_JumpFloodInitialize:MaterialExpressionScalarParameter_9'"))
      MaterialExpressionEditorX=-592
      MaterialExpressionEditorY=288
      MaterialExpressionGuid=A608E6B14B445481886B6AAA2FA0FC6A
      Material="/Script/Engine.Material'M_JumpFloodInitialize'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_4" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Materials/M_JumpFloodInitialize.M_JumpFloodInitialize:MaterialExpressionCustom_4'"
      Code="struct Functions\r\n{\r\n  float Sig(float c)\r\n  {\r\n      return (c > 0.0) ? 1.0 : 0.0;\r\n  }\r\n\r\n float interp(float SC, float SL)\r\n {\r\n\tif (SC >= 0.0 && SL < 0.0)\r\n\t{\r\n\t\treturn (SC / (SC - SL));\r\n\t} else\r\n\t{\r\n\t\treturn 0.0;\r\n\t}\r\n }\r\n};\r\n\r\n \r\nfloat SC = Texture2DSample(inTexture, inTextureSampler, uv * TexInvR).x;\r\nfloat SL = Texture2DSample(inTexture, inTextureSampler, (uv+float2(-1,0)) * TexInvR).x;\r\nfloat SR = Texture2DSample(inTexture, inTextureSampler, (uv+float2(1,0)) * TexInvR).x;\r\nfloat ST = Texture2DSample(inTexture, inTextureSampler, (uv+float2(0,1)) * TexInvR).x;\r\nfloat SB = Texture2DSample(inTexture, inTextureSampler, (uv+float2(0,-1)) * TexInvR).x;\r\n\r\nFunctions f;\r\nfloat4 neighbors = float4(f.Sig(SL), f.Sig(SR), f.Sig(ST), f.Sig(SB));\r\nfloat center = f.Sig(SC);\r\n \r\nfloat test = 1.0; // = dot(1.0-neighbors, float4(center, center, center,center));\r\nif (SC > 0.0)\r\n{\r\n\tif (SL <= 0.0 || SR <= 0.0 || ST <= 0.0 || SB <= 0.0)\r\n\t\ttest = 0.0;\r\n} else\r\n{\r\n\tif (SL > 0.0 || SR > 0.0  || ST > 0.0  || SB > 0.0)\r\n\t\ttest = 0.0;\r\n}\r\n\r\nif(dot(1.0-neighbors, float4(center, center, center,center)) >= 0.5)\r\n{\r\n\tfloat2 offset = float2(0.0, 0.0);\r\n\t\r\n\toffset.x -= f.interp(SC, SL);\t\r\n \toffset.x += f.interp(SC, SR);\r\n\toffset.y -= f.interp(SC, SB);\t\r\n \toffset.y += f.interp(SC, ST);\r\n\t\r\n\tif\t(SC > 0.0)\r\n\t{\r\n\t\treturn -float2(uv + offset);\t\r\n\t}\r\n\telse\r\n\t{\r\n\t\treturn float2(uv - offset);\r\n\t}\r\n\t\r\n}\t else\r\n{\r\n\tif(SC > 0.0)\r\n\t{\r\n\t\treturn -float2(65535, 65535);\r\n\t}\r\n\telse\r\n\t{\r\n \t\treturn float2(65535,65535);\r\n\t}\r\n} "
      OutputType=CMOT_Float2
      Description="Old"
      Inputs(0)=(InputName="uv")
      Inputs(1)=(InputName="inTexture")
      Inputs(2)=(InputName="TexInvR")
      MaterialExpressionEditorX=-766
      MaterialExpressionEditorY=866
      MaterialExpressionGuid=79D74F33475ACFD6935E2A860B8FAC2B
      Material="/Script/Engine.Material'M_JumpFloodInitialize'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Materials/M_JumpFloodInitialize.M_JumpFloodInitialize:MaterialExpressionCustom_2'"
      Code="struct Functions\r\n{\r\n  float Sig(float c)\r\n  {\r\n      return (c > 0.0) ? 1.0 : 0.0;\r\n  }\r\n\r\n};\r\n\r\nFunctions f;\r\n\r\nfloat4 neighbors = float4(f.Sig(SL), f.Sig(SR), f.Sig(ST), f.Sig(SB));\r\nfloat center = f.Sig(SC);\r\n\r\nif(dot(1.0-neighbors, float4(center, center, center,center)) < 0.5)\r\n{\r\n\tif(center == 0.0)\r\n\t{\r\n\t\treturn float2(-65535,-65535);\r\n\t}\r\n\telse\r\n\t{\r\n\t\treturn float2(65535, 65535);\r\n\t}\r\n} else\r\n{\r\n\treturn float2(uv );\r\n}"
      OutputType=CMOT_Float2
      Description="Old"
      Inputs(0)=(InputName="SC")
      Inputs(1)=(InputName="SR")
      Inputs(2)=(InputName="SL")
      Inputs(3)=(InputName="ST")
      Inputs(4)=(InputName="SB")
      Inputs(5)=(InputName="uv")
      MaterialExpressionEditorX=-558
      MaterialExpressionEditorY=850
      MaterialExpressionGuid=79D74F33475ACFD6935E2A860B8FAC2B
      Material="/Script/Engine.Material'M_JumpFloodInitialize'"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Materials/M_JumpFloodInitialize.M_JumpFloodInitialize:MaterialExpressionCustom_1'"
      Code="Edge = 0.0;\r\nOffset = float2(0.0, 0.0);\r\n\r\n\r\nif (SC > 0.0 && SL > 0.0 && SR > 0.0 && SB > 0.0 && ST > 0.0)\r\n{\r\n\tEdge = 1.0;\r\n}\r\n\r\nif (SC <= 0.0 && SL <= 0.0 && SR <= 0.0 && SB <= 0.0 && ST <= 0.0)\r\n{\r\n\tEdge = 1.0;\r\n}\r\n\r\n"
      OutputType=CMOT_Float2
      Inputs(0)=(InputName="SC")
      Inputs(1)=(InputName="SR")
      Inputs(2)=(InputName="SL")
      Inputs(3)=(InputName="ST")
      Inputs(4)=(InputName="SB")
      AdditionalOutputs(0)=(OutputName="Edge")
      AdditionalOutputs(1)=(OutputName="Offset",OutputType=CMOT_Float2)
      MaterialExpressionEditorX=-382
      MaterialExpressionEditorY=834
      MaterialExpressionGuid=79D74F33475ACFD6935E2A860B8FAC2B
      Material="/Script/Engine.Material'M_JumpFloodInitialize'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="Edge")
      Outputs(2)=(OutputName="Offset")
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Materials/M_JumpFloodInitialize.M_JumpFloodInitialize:MaterialExpressionCustom_0'"
      Code="struct Functions\r\n{\r\n  float Sig(float c)\r\n  {\r\n      return (c > 0.0) ? 1.0 : 0.0;\r\n  }\r\n\r\n float interp(float SC, float SL)\r\n { \r\n\tif (SC >= 0.0 && SL < 0.0)\r\n\t{\r\n\t\treturn (SC / (SC - SL));\r\n\t} else\r\n\tif (SC < 0.0 && SL > 0.0)\r\n\t{\r\n\t\treturn -(SC / (SC - SL));\r\n\t} else\r\n\t{\r\n\t\treturn 0.0;\r\n\t}\r\n }\r\n};\r\n\r\n \r\nfloat SC = Texture2DSample(inTexture, inTextureSampler, uv * TexInvR).x;\r\nfloat SL = Texture2DSample(inTexture, inTextureSampler, (uv+float2(-1,0)) * TexInvR).x;\r\nfloat SR = Texture2DSample(inTexture, inTextureSampler, (uv+float2(1,0)) * TexInvR).x;\r\nfloat ST = Texture2DSample(inTexture, inTextureSampler, (uv+float2(0,1)) * TexInvR).x;\r\nfloat SB = Texture2DSample(inTexture, inTextureSampler, (uv+float2(0,-1)) * TexInvR).x;\r\n\r\nFunctions f;\r\n\r\nfloat test = 1.0;\r\nif (SC > 0.0)\r\n{\r\n\tif (SL < 0.0 || SR < 0.0 || ST < 0.0 || SB < 0.0)\r\n\t\ttest = 0.0;\r\n} else\r\n{\r\n\tif (SL > 0.0 || SR > 0.0  || ST > 0.0  || SB > 0.0)\r\n\t\ttest = 0.0;\r\n}\r\n\r\nif(test < 0.5)\r\n{\r\n\tfloat2 offset = float2(0.0, 0.0);\r\n\t\r\n\toffset.x -= f.interp(SC, SL);\t\r\n \toffset.x += f.interp(SC, SR);\r\n\toffset.y -= f.interp(SC, SB);\t\r\n \toffset.y += f.interp(SC, ST);\r\n\t\r\n\tif\t(SC > 0.0)\r\n\t{\r\n\t\treturn -float2(uv + offset);\t\r\n\t}\r\n\telse\r\n\t{\r\n\t\treturn float2(uv - offset);\r\n\t}\r\n\t\r\n}\t else\r\n{\r\n\tif(SC > 0.0)\r\n\t{\r\n\t\treturn -float2(65535, 65535);\r\n\t}\r\n\telse\r\n\t{\r\n \t\treturn float2(65535,65535);\r\n\t}\r\n} "
      OutputType=CMOT_Float2
      Description="Old"
      Inputs(0)=(InputName="uv",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'M_JumpFloodInitialize:MaterialExpressionMultiply_5'"))
      Inputs(1)=(InputName="inTexture",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_JumpFloodInitialize:MaterialExpressionTextureObjectParameter_0'"))
      Inputs(2)=(InputName="TexInvR",Input=(Expression="/Script/Engine.MaterialExpressionDivide'M_JumpFloodInitialize:MaterialExpressionDivide_0'"))
      MaterialExpressionEditorX=-334
      MaterialExpressionEditorY=1170
      MaterialExpressionGuid=79D74F33475ACFD6935E2A860B8FAC2B
      Material="/Script/Engine.Material'M_JumpFloodInitialize'"
   End Object
