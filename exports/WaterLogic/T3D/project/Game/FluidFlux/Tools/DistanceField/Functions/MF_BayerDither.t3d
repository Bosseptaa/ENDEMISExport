   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Functions/MF_BayerDither.MF_BayerDither:MaterialExpressionCustom_0'"
      Code="float DITHER_THRESHOLDS[16] =\r\n{\r\n1.0 / 17.0,  9.0 / 17.0,  3.0 / 17.0, 11.0 / 17.0,\r\n13.0 / 17.0,  5.0 / 17.0, 15.0 / 17.0,  7.0 / 17.0,\r\n4.0 / 17.0, 12.0 / 17.0,  2.0 / 17.0, 10.0 / 17.0,\r\n16.0 / 17.0,  8.0 / 17.0, 14.0 / 17.0,  6.0 / 17.0\r\n};\r\n\r\n\r\nuint index = uint(position.x) % 4 + uint(position.y) % 4 * 4;\r\n\r\n\r\nif (Transparency - DITHER_THRESHOLDS[index] <= 0)\r\n{\r\nreturn 0.0;\r\n} else\r\n{\r\nreturn 1.0;\r\n}"
      OutputType=CMOT_Float1
      Description="Dither 4"
      Inputs(0)=(InputName="position",Input=(Expression="/Script/Engine.MaterialExpressionAdd'MF_BayerDither:MaterialExpressionAdd_2'"))
      Inputs(1)=(InputName="Transparency",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_BayerDither:MaterialExpressionFunctionInput_0'"))
      MaterialExpressionEditorX=-640
      MaterialExpressionEditorY=320
      MaterialExpressionGuid=3DD12D814354955B73DCF084C75F0609
      Function="/Script/Engine.MaterialFunction'MF_BayerDither'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Functions/MF_BayerDither.MF_BayerDither:MaterialExpressionCustom_2'"
      Code="    uint2 b = uint2(a);\r\n    uint c = (b.x^b.y)<<1u;\r\n    float t = float(\r\n        ((c&8u|b.y&4u)>>2u)|\r\n        ((c&4u|b.y&2u)<<1u)|\r\n        ((c&2u|b.y&1u)<<4u) \r\n    )/8./8.;\r\n\r\nif (Transparency <  t + 0.5-0.4921875)\r\n{\r\n  return 0.0;\r\n} else\r\n{\r\n  return 1.0;\r\n}"
      Description="Dither 8"
      Inputs(0)=(InputName="a",Input=(Expression="/Script/Engine.MaterialExpressionScreenPosition'MF_BayerDither:MaterialExpressionScreenPosition_1'",OutputIndex=1))
      Inputs(1)=(InputName="Transparency",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_BayerDither:MaterialExpressionFunctionInput_0'"))
      MaterialExpressionEditorX=-640
      MaterialExpressionEditorY=224
      MaterialExpressionGuid=3A5AD76040328EBA91B25787228269F0
      Function="/Script/Engine.MaterialFunction'MF_BayerDither'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Tools/DistanceField/Functions/MF_BayerDither.MF_BayerDither:MaterialExpressionCustom_5'"
      Code="    uint2 b = uint2(a);\r\n    \r\n    uint x = b.x^b.y;\r\n    uint y = b.y;\r\n    uint z = ((x&0xfu)<<8) | (y &0xfu); \r\n    z = (z | (z<<6)) & 0xccccu;\r\n    z = (z | (z>>3)) & 0x5555u;\r\n \r\n   float t= float((z>>7)|(z&0xffu))/16./16.;\r\n\r\nif\r\n\r\n (Transparency < t + 0.5-0.498046875)\r\n{\r\n  return 0.0;\r\n} else\r\n{\r\n  return 1.0;\r\n}"
      Description="Dither 16"
      Inputs(0)=(InputName="a",Input=(Expression="/Script/Engine.MaterialExpressionScreenPosition'MF_BayerDither:MaterialExpressionScreenPosition_1'",OutputIndex=1))
      Inputs(1)=(InputName="Transparency",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_BayerDither:MaterialExpressionFunctionInput_0'"))
      MaterialExpressionEditorX=-640
      MaterialExpressionEditorY=128
      MaterialExpressionGuid=FE2176894E89D947A0F428BEDF4E91E0
      Function="/Script/Engine.MaterialFunction'MF_BayerDither'"
      bCollapsed=True
   End Object
