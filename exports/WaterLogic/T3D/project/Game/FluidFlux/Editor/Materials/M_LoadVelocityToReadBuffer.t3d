   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/FluidFlux/Editor/Materials/M_LoadVelocityToReadBuffer.M_LoadVelocityToReadBuffer:MaterialExpressionCustom_0'"
      Code="int blur_samples = int(samples);\r\nfloat height = 0.0f;\r\n\r\nfor (int i = -blur_samples; i < blur_samples; i ++)\r\n{\r\n\tfor (int j = -blur_samples; j < blur_samples; j ++)\r\n\t{\t\r\n\t\tfloat2 uv = coords + float2(i,j) * size;\r\n\t\t\r\n\t\tif (min(uv.x,uv.y) >= 0.0 && max(uv.x,uv.y) <= 1.0)\r\n\t\t{\r\n\t\t\tfloat4 sample = Texture2DSample(tex_in, tex_inSampler, uv);\t\r\n\t\t\tfloat2 velocity = float2(0.0,0.0);\r\n\t\t\tfloat volume = sample.z * VolumeScale;\r\n\t \r\n\t\t\theight = max(height, max(volume, length(velocity) - 0.01f));\r\n\t\t}\t\t\r\n\t}\r\n}\r\nreturn height;"
      OutputType=CMOT_Float1
      Description="Visibility"
      Inputs(0)=(InputName="VolumeScale",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'M_LoadVelocityToReadBuffer:MaterialExpressionMaterialFunctionCall_0'",OutputIndex=2))
      Inputs(1)=(InputName="size",Input=(Expression="/Script/Engine.MaterialExpressionTextureProperty'M_LoadVelocityToReadBuffer:MaterialExpressionTextureProperty_8'"))
      Inputs(2)=(InputName="coords",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'M_LoadVelocityToReadBuffer:MaterialExpressionTextureCoordinate_8'"))
      Inputs(3)=(InputName="samples",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'M_LoadVelocityToReadBuffer:MaterialExpressionScalarParameter_0'"))
      Inputs(4)=(InputName="tex_in",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'M_LoadVelocityToReadBuffer:MaterialExpressionTextureObjectParameter_2'"))
      MaterialExpressionEditorX=288
      MaterialExpressionEditorY=208
      MaterialExpressionGuid=0987640C4EEF0911AF331D8F8C4B6C24
      Material="/Script/Engine.Material'M_LoadVelocityToReadBuffer'"
      bCollapsed=True
   End Object
