   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_ContainerVolume.MF_ContainerVolume:MaterialExpressionCustom_1'"
      Code="float DirScattLuminancePhase = PhaseG;\r\nfloat3 AmbIsotropicPhase = AmbientPhase / (4.0f * PI);\r\n\r\nfloat DirectionalLightShadow = 1.0;\r\n\r\nfloat3 SunIlluminance = ResolvedView.DirectionalLightColor.rgb* DirectionalLightShadow * PI;\r\n\r\nfloat3 ExtinctionCoeff = ScatteringCoeff + AbsorptionCoeff;\r\nfloat3 ExtinctionCoeffSafe = max(ScatteringCoeff + AbsorptionCoeff, 1e-5); \r\n \r\nfloat3 Transmittance = exp(-ExtinctionCoeff * BehindWaterDeltaDepth);\r\nfloat3 LuminanceCoeff = (ScatteringCoeff / ExtinctionCoeffSafe) * (1.0 - Transmittance);\r\nfloat3 ScatteredLuminance = LuminanceCoeff * (AmbientIlluminance + ((AmbIsotropicPhase + DirScattLuminancePhase ) * SunIlluminance));\r\n \r\nFogAbsorption = Transmittance;\r\nFogColor = ScatteredLuminance;//* ResolvedView.OneOverPreExposure;\r\nFogAlpha = dot(ScatteredLuminance, 0.3333);\r\nreturn 0;\r\n"
      OutputType=CMOT_Float1
      Description="SLWUnderwater"
      Inputs(0)=(InputName="ScatteringCoeff",Input=(Expression="/Script/Engine.MaterialExpressionConstant3Vector'MF_ContainerVolume:MaterialExpressionConstant3Vector_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="AbsorptionCoeff",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_ContainerVolume:MaterialExpressionMaterialFunctionCall_5'",OutputIndex=7))
      Inputs(2)=(InputName="PhaseG",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_ContainerVolume:MaterialExpressionConstant_3'"))
      Inputs(3)=(InputName="AmbientPhase",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_ContainerVolume:MaterialExpressionConstant_4'"))
      Inputs(4)=(InputName="BehindWaterDeltaDepth",Input=(Expression="/Script/Engine.MaterialExpressionMax'MF_ContainerVolume:MaterialExpressionMax_0'"))
      Inputs(5)=(InputName="AmbientIlluminance",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_ContainerVolume:MaterialExpressionConstant_6'"))
      AdditionalOutputs(0)=(OutputName="FogColor",OutputType=CMOT_Float3)
      AdditionalOutputs(1)=(OutputName="FogAlpha")
      AdditionalOutputs(2)=(OutputName="FogAbsorption",OutputType=CMOT_Float3)
      MaterialExpressionEditorX=448
      MaterialExpressionEditorY=-155
      MaterialExpressionGuid=DD653AED49ED9AFAE271F492F1528C6D
      Function="/Script/Engine.MaterialFunction'MF_ContainerVolume'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="FogColor")
      Outputs(2)=(OutputName="FogAlpha")
      Outputs(3)=(OutputName="FogAbsorption")
   End Object
