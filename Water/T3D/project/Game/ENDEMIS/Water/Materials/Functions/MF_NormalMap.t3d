   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_NormalMap.MF_NormalMap:MaterialExpressionCustom_1'"
      Code="float x = offset.x;\r\nfloat y = offset.y;\r\n\r\nfloat n0 = Tex.SampleLevel(TexSampler, uv + float2(-x,-y),0).x;\r\nfloat n1 = Tex.SampleLevel(TexSampler, uv + float2( 0, -y),0).x;\r\nfloat n2 = Tex.SampleLevel(TexSampler, uv + float2(+x,-y),0).x;\r\nfloat n3 = Tex.SampleLevel(TexSampler, uv + float2(-x,  0),0).x;\r\nfloat n4 = Tex.SampleLevel(TexSampler, uv + float2( 0, 0),0).x;\r\nfloat n5 = Tex.SampleLevel(TexSampler, uv + float2(+x,  0),0).x;\r\nfloat n6 = Tex.SampleLevel(TexSampler, uv + float2(-x,+y),0).x;\r\nfloat n7 = Tex.SampleLevel(TexSampler, uv + float2( 0, +y),0).x;\r\nfloat n8 = Tex.SampleLevel(TexSampler, uv + float2(+x,+y),0).x;\r\n\r\nfloat sobel_edge_h = n2 + (2.0*n5) + n8 - (n0 + (2.0*n3) + n6);\r\nfloat sobel_edge_v = n0 + (2.0*n1) + n2 - (n6 + (2.0*n7) + n8);\r\nfloat sobel = sqrt((sobel_edge_h * sobel_edge_h) + (sobel_edge_v * sobel_edge_v));\r\n\r\nreturn sobel;"
      OutputType=CMOT_Float1
      Description="Edge"
      Inputs(0)=(InputName="Tex")
      Inputs(1)=(InputName="offset")
      Inputs(2)=(InputName="uv")
      MaterialExpressionEditorX=-3056
      MaterialExpressionEditorY=1056
      MaterialExpressionGuid=A35576D64ADA1222EF7333A5B8B9E409
      Function="/Script/Engine.MaterialFunction'MF_NormalMap'"
   End Object
