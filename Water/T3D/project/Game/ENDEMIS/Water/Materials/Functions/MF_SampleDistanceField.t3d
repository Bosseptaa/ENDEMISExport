   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_SampleDistanceField.MF_SampleDistanceField:MaterialExpressionCustom_0'"
      Code="\r\n uv =  (Position.xy - SDFPosition.xy) / SDFSize.xy + 0.5;\r\n\r\n[branch]\r\nif (all(uv >= 0.0) && all(uv <= 1.0))\r\n{\t\r\n\tfloat2 MinMaxZ = SDFPosition.z + SDFSize.z * float2(-0.5, 0.5);\r\n\r\n\r\n\tfloat layerIndex = saturate((Position.z - MinMaxZ.x) / (MinMaxZ.y - MinMaxZ.x)) * (SDFTiles.z - 1.0);\r\n\t\r\n\tblend = frac(layerIndex);\r\n\tfloat frameID = layerIndex - blend;\r\n\t\r\n\tfloat2 InvTiles = 1.0/SDFTiles.xy;\r\n\tfloat idTileA = frameID * InvTiles.x;\r\n\tfloat fracTileA = frac(idTileA);\r\n\tfloat2 ruvA = (uv + float2(fracTileA * SDFTiles.x, (idTileA - fracTileA))) * InvTiles.xy;\r\n\r\n\tfloat idTileB = (frameID + 1.0) * InvTiles.x;\r\n\tfloat fracTileB = frac(idTileB);\r\n\tfloat2 ruvB = (uv + float2(fracTileB * SDFTiles.x, (idTileB - fracTileB))) * InvTiles.xy;\r\n\r\n\tfloat texA = Texture2DSample(SDFMap, SDFMapSampler, ruvA).r;\r\n\tfloat texB = Texture2DSample(SDFMap, SDFMapSampler, ruvB).r;\r\n\r\n\tfloat ExtrudeEdge = max(0.0, -(Position.z - MinMaxZ.x)) + max(0.0, Position.z - MinMaxZ.y);\r\n\t\r\n\treturn ( lerp(texA, texB, blend) - 0.5) * SDFRange - ExtrudeEdge;\r\n\t\r\n} else\r\n{\r\n\tblend = 0.0;\r\n\treturn -0.5 * SDFRange;\r\n}\r\n"
      OutputType=CMOT_Float1
      Description="SampleSDFVolume2D"
      Inputs(0)=(InputName="Position",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_SampleDistanceField:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="SDFTiles",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_SampleDistanceField:MaterialExpressionMaterialFunctionCall_3'"))
      Inputs(2)=(InputName="SDFRange",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_SampleDistanceField:MaterialExpressionMaterialFunctionCall_3'",OutputIndex=1))
      Inputs(3)=(InputName="SDFPosition",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_SampleDistanceField:MaterialExpressionMaterialFunctionCall_3'",OutputIndex=2))
      Inputs(4)=(InputName="SDFSize",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_SampleDistanceField:MaterialExpressionMaterialFunctionCall_3'",OutputIndex=3))
      Inputs(5)=(InputName="SDFMap",Input=(Expression="/Script/Engine.MaterialExpressionTextureObjectParameter'MF_SampleDistanceField:MaterialExpressionTextureObjectParameter_0'"))
      AdditionalOutputs(0)=(OutputName="blend")
      AdditionalOutputs(1)=(OutputName="uv",OutputType=CMOT_Float2)
      MaterialExpressionEditorX=-688
      MaterialExpressionEditorY=336
      MaterialExpressionGuid=522381124B751D2E9CECE2B37B53F8EF
      Function="/Script/Engine.MaterialFunction'MF_SampleDistanceField'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="blend")
      Outputs(2)=(OutputName="uv")
   End Object
