   Begin Object Name="MaterialExpressionCustom_10" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_CameraPlane.MF_CameraPlane:MaterialExpressionCustom_10'"
      Code=" float2 viewpos = (ScreenPos.xy - View.ScreenPositionScaleBias.wz) / View.ScreenPositionScaleBias.xy * NearPlane; \r\n return float4( viewpos, NearPlane, 1 ) ;"
      OutputType=CMOT_Float4
      Description="ScreenPos to ViewPos"
      Inputs(0)=(InputName="ScreenPos",Input=(Expression="/Script/Engine.MaterialExpressionMaterialFunctionCall'MF_CameraPlane:MaterialExpressionMaterialFunctionCall_2'"))
      Inputs(1)=(InputName="NearPlane",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'MF_CameraPlane:MaterialExpressionScalarParameter_2'"))
      MaterialExpressionEditorX=-720
      MaterialExpressionEditorY=-16
      MaterialExpressionGuid=017E743E4526C11DA5FDB79A16DB1FE9
      Function="/Script/Engine.MaterialFunction'MF_CameraPlane'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_15" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_CameraPlane.MF_CameraPlane:MaterialExpressionCustom_15'"
      Code="#if defined(PrimaryLWCToFloat)\r\n\tfloat4 pos = mul( ViewPos , PrimaryLWCToFloat(PrimaryLWCToFloat(ResolvedView.ScreenToWorld)) );\r\n#else\r\n\tfloat4 pos = mul( ViewPos , LWCToFloat(ResolvedView.ScreenToWorld) );\r\n#endif\r\n\r\nreturn pos.xyz * (1 / pos.w);"
      Description="ViewPos to WorldPos"
      Inputs(0)=(InputName="ViewPos",Input=(Expression="/Script/Engine.MaterialExpressionCustom'MF_CameraPlane:MaterialExpressionCustom_10'"))
      MaterialExpressionEditorX=-464
