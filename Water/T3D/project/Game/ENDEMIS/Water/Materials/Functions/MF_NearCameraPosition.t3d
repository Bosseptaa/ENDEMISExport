   Begin Object Name="MaterialExpressionCustom_10" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_NearCameraPosition.MF_NearCameraPosition:MaterialExpressionCustom_10'"
      Code=" float2 viewpos = (ScreenPos.xy - View.ScreenPositionScaleBias.wz) / View.ScreenPositionScaleBias.xy * NearPlane; \r\n return float4( viewpos, NearPlane, 1 ) ;"
      OutputType=CMOT_Float4
      Description="ScreenPos to ViewPos"
      Inputs(0)=(InputName="ScreenPos",Input=(Expression="/Script/Engine.MaterialExpressionAdd'MF_NearCameraPosition:MaterialExpressionAdd_11'"))
      Inputs(1)=(InputName="NearPlane",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_NearCameraPosition:MaterialExpressionFunctionInput_1'"))
      MaterialExpressionEditorX=-640
      MaterialExpressionEditorY=1152
      MaterialExpressionGuid=B33DBA324A9F569AB6F4868E584B7D4F
      Function="/Script/Engine.MaterialFunction'MF_NearCameraPosition'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_15" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_NearCameraPosition.MF_NearCameraPosition:MaterialExpressionCustom_15'"
      Code="#if defined(PrimaryLWCToFloat)\r\n\tfloat4 pos = mul( ViewPos , PrimaryLWCToFloat(PrimaryLWCToFloat(ResolvedView.ScreenToWorld)) );\r\n#else\r\n\tfloat4 pos = mul( ViewPos , LWCToFloat(ResolvedView.ScreenToWorld) );\r\n#endif\r\n\r\nreturn pos.xyz * (1 / pos.w);"
      Description="ViewPos to WorldPos"
      Inputs(0)=(InputName="ViewPos",Input=(Expression="/Script/Engine.MaterialExpressionCustom'MF_NearCameraPosition:MaterialExpressionCustom_10'"))
      MaterialExpressionEditorX=-416
      MaterialExpressionEditorY=1152
      MaterialExpressionGuid=B33DBA324A9F569AB6F4868E584B7D4F
      Function="/Script/Engine.MaterialFunction'MF_NearCameraPosition'"
      bCollapsed=True
   End Object
   Begin Object Name="MaterialExpressionCustom_17" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_NearCameraPosition.MF_NearCameraPosition:MaterialExpressionCustom_17'"
