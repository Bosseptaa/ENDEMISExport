   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_Aberration.MF_Aberration:MaterialExpressionCustom_3'"
      Code="BRANCH\r\nif (TestMask <=  0.0)\r\n{\r\n\tint SceneTextureID = 14;\r\n\tUV = ClampSceneTextureUV(ViewportUVToSceneTextureUV(UV, 14), 14);\r\n\t\r\n\tfloat2 StepSize = (Distance * Vector) / (int) Steps;\r\n\tfloat2 NewUV =  UV - Vector * Distance * 0.5;\r\n\tfloat3 CurColor = float3(0.0f, 0.0f,0.0f);\r\n\tint i;\r\n\tfloat3 sum = float3(0.0f, 0.0f,0.0f);\r\n\tfor (i = 0; i < (int)Steps; i++)\r\n\t{\r\n\t\tfloat3 CurrentAbberationValue=saturate(1.0-abs(3*(i/Steps)-float3(0.0,1.0,2.0)));\r\n\t\tCurColor += SceneTextureLookup(NewUV, SceneTextureID, true).rgb * CurrentAbberationValue;\r\n\t\tNewUV.xy += StepSize;\r\n\t\tsum += CurrentAbberationValue;\r\n\t}\r\n\tCurColor = CurColor / sum;\r\n\treturn CurColor;\r\n} else\r\n{\r\n\treturn DefaultColor;\t\r\n}\r\n "
      Description="Aberration"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Aberration:MaterialExpressionFunctionInput_1'"))
      Inputs(1)=(InputName="Vector",Input=(Expression="/Script/Engine.MaterialExpressionConstant2Vector'MF_Aberration:MaterialExpressionConstant2Vector_2'"))
      Inputs(2)=(InputName="Distance",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'MF_Aberration:MaterialExpressionMultiply_0'"))
      Inputs(3)=(InputName="Steps",Input=(Expression="/Script/Engine.MaterialExpressionConstant'MF_Aberration:MaterialExpressionConstant_2'"))
      Inputs(4)=(InputName="DefaultColor",Input=(Expression="/Script/Engine.MaterialExpressionSceneTexture'MF_Aberration:MaterialExpressionSceneTexture_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1))
      Inputs(5)=(InputName="TestMask",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Aberration:MaterialExpressionFunctionInput_2'"))
      MaterialExpressionEditorX=-544
      MaterialExpressionEditorY=784
      MaterialExpressionGuid=94228BE74CEC205A083E1082B0E2A6C5
      Function="/Script/Engine.MaterialFunction'MF_Aberration'"
   End Object
