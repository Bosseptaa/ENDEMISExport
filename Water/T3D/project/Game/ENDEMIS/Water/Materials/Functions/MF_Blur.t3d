   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/ENDEMIS/Water/Materials/Functions/MF_Blur.MF_Blur:MaterialExpressionCustom_0'"
      Code="struct Functions\r\n{\r\nfloat4 saturate(float4 v) {\r\n  return clamp(v, 0.0, 1.0);\r\n}\r\n\r\nfloat gaussian(float v, float twoSigmaSq) {\r\n  return exp(-(v * v) / twoSigmaSq);  \r\n}\r\n\r\nfloat4 gaussian4(float4 v, float twoSigmaSq) {\r\n  return exp(-(v * v) / twoSigmaSq);\r\n}\r\n\r\nfloat4 truncatedGaussian(float4 v, float twoSigmaSq, float trunc) {\r\n  return saturate(gaussian4(v, twoSigmaSq) - trunc); \r\n}\r\n};\r\n[branch]\r\nif (Mask < 0.01)\r\n{\r\nFunctions f;\r\n  int SceneTextureID = 14;\r\n\r\n\r\n  float2 texCoord =  ClampSceneTextureUV(ViewportUVToSceneTextureUV(UV, 14), 14);\r\n  float sigma = 4.0 ;\r\n  float twoSigmaSq = sigma * sigma * 2.0; \r\n  float trunc = f.gaussian(5.0, twoSigmaSq);  \r\n\r\n  float2 size = View.BufferSizeAndInvSize.xy;\r\n  float2 texel = float2(1.0, 1.0) / size.xy;\r\n\r\n  float2 a = frac(texCoord * size.xy - float2(0.5,0.5));\r\n\r\n  const float4 one = float4(1.0,1.0,1.0,1.0);\r\n\r\n  float4 xDist0 = -a.xxxx + float4(-3.0, -1.0, 1.0, 3.0);\r\n  float4 xDist1 = xDist0 + one;\r\n  float4 yDist0 = -a.yyyy + float4(-3.0, -1.0, 1.0, 3.0);\r\n  float4 yDist1 = yDist0 + one;\r\n\r\n  float4 gx0 = f.truncatedGaussian(xDist0, twoSigmaSq, trunc);\r\n  float4 gx1 = f.truncatedGaussian(xDist1, twoSigmaSq, trunc);\r\n  float4 gy0 = f.truncatedGaussian(yDist0, twoSigmaSq, trunc);\r\n  float4 gy1 = f.truncatedGaussian(yDist1, twoSigmaSq, trunc);\r\n\r\n  float4 gx01 = gx0 + gx1;\r\n  float4 gy01 = gy0 + gy1;\r\n  float4 xOffsets = (xDist0 + (gx1 / gx01)) * texel.x;\r\n  float4 yOffsets = (yDist0 + (gy1 / gy01)) * texel.y;\r\n\r\n  float4 w0 = gx01 * gy01.x;\r\n  float4 w1 = gx01 * gy01.y;\r\n  float4 w2 = gx01 * gy01.z;\r\n  float4 w3 = gx01 * gy01.w;\r\n\r\n  float4 result = float4(0.0,0.0,0.0,0.0);\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.x, yOffsets.x),SceneTextureID,true) * w0.x;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.y, yOffsets.x),SceneTextureID,true) * w0.y;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.z, yOffsets.x),SceneTextureID,true) * w0.z;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.w, yOffsets.x),SceneTextureID,true) * w0.w;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.x, yOffsets.y),SceneTextureID,true) * w1.x;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.y, yOffsets.y),SceneTextureID,true) * w1.y;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.z, yOffsets.y),SceneTextureID,true) * w1.z;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.w, yOffsets.y),SceneTextureID,true) * w1.w;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.x, yOffsets.z),SceneTextureID,true) * w2.x;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.y, yOffsets.z),SceneTextureID,true) * w2.y;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.z, yOffsets.z),SceneTextureID,true) * w2.z;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.w, yOffsets.z),SceneTextureID,true) * w2.w;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.x, yOffsets.w),SceneTextureID,true) * w3.x;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.y, yOffsets.w),SceneTextureID,true) * w3.y;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.z, yOffsets.w),SceneTextureID,true) * w3.z;\r\n  result += SceneTextureLookup( texCoord + float2(xOffsets.w, yOffsets.w),SceneTextureID,true) * w3.w;\r\n\r\n  float weight = dot(one, w0) + dot(one, w1) + dot(one, w2) + dot(one, w3);\r\n  return result.rgb / weight;\r\n}\r\nreturn Color.rgb;"
      Description="Blur_16x16"
      Inputs(0)=(InputName="Mask",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Blur:MaterialExpressionFunctionInput_2'"))
      Inputs(1)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'MF_Blur:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="Color",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'MF_Blur:MaterialExpressionComponentMask_2'"))
      MaterialExpressionEditorX=-272
      MaterialExpressionEditorY=800
      MaterialExpressionGuid=94228BE74CEC205A083E1082B0E2A6C5
      Function="/Script/Engine.MaterialFunction'MF_Blur'"
      Desc=" "
      bCommentBubbleVisible=True
      bCollapsed=True
   End Object
